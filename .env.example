# Copy to .env for local development. Never commit real credentials.
# Contract: docs/bootstrap.md -> Environment variable contract.

# PostgreSQL connection string (development defaults match compose.yaml).
DATABASE_URL="postgresql://zfactory:zfactory@localhost:5432/zfactory"

# Optional: database the integration tests may reset. Integration tests are skipped when unset.
TEST_DATABASE_URL="postgresql://zfactory:zfactory@localhost:5432/zfactory_test"

# Single-owner mode (ADR-0007): the owner every factory belongs to. Optional in
# development (defaults to "local-owner"); REQUIRED in production, where the app
# refuses all factory operations without it.
# LOCAL_OWNER_ID=local-owner

# Docker Engine endpoint used by the server (never by the browser). Default shown.
# Use tcp://host:port to go through a constrained Docker API proxy.
# DOCKER_HOST=unix:///var/run/docker.sock

# Secret the per-container runtime API credentials are derived from (at least 32 characters).
# Optional in development; REQUIRED in production. Changing it requires recreating runtime containers.
# RUNTIME_SECRET=

# Host ports runtime containers may publish, and the addresses they may bind to.
# RUNTIME_PORT_RANGE=15000-15999
# RUNTIME_BIND_ADDRESSES=127.0.0.1

# Device simulator: cycle time and how often device states are stored, in milliseconds.
# SIMULATION_TICK_MS=100
# SIMULATION_SNAPSHOT_MS=10000

# Catalog 3D assets: directory the GLB files are stored in. Back it up with the database.
# ASSET_STORAGE_DIR=./data/assets

# Optional: Meshy API key, read only by the asset authoring script (npm run assets -- generate).
# Generation spends Meshy credits. The application itself never needs or sends this key.
# MESHY_API_KEY=

# Optional: the process simulation service (ADR-0008). The server talks to it with the token;
# the browser never does. Start it with `docker compose --profile sim up -d process-sim`.
# PROCESS_SIM_URL=http://127.0.0.1:7700
# PROCESS_SIM_TOKEN=
# Limits of the service itself (read by the container, not by the application):
# PROCESS_SIM_MAX_INSTANCES=256
# PROCESS_SIM_MAX_DEVICES=2048
# Process bridge: simulated time per model tick, and real time between exchanges with the PLCs.
# PROCESS_SIM_TICK_MS=100
# PROCESS_BRIDGE_CYCLE_MS=200

# Live values: how often the tags of a running PLC are read, in milliseconds.
# TAG_POLL_MS=500

# Telemetry: a tag is stored when it changes by the deadband, at most every MIN and at least every MAX.
# TELEMETRY_MIN_INTERVAL_MS=1000
# TELEMETRY_MAX_INTERVAL_MS=60000
# TELEMETRY_DEADBAND_PERCENT=1

# Retention of stored telemetry (hours) and of recorded events and cleared alarms (days).
# TELEMETRY_RETENTION_HOURS=24
# EVENT_RETENTION_DAYS=30

# Optional: set to 1 to run the Docker lifecycle integration tests against the engine above.
# They create and remove their own labelled test network and containers.
# TEST_DOCKER=1

# Optional: set to 1 to run the browser-agent end-to-end test (TASK-1008). It starts the
# production build (`npm run build` first) on the test database and drives a real Chromium:
# CHROME_BIN, or the browser Playwright cached under ~/.cache/ms-playwright, or one on the PATH.
# TEST_BROWSER_OUT names a directory for its screenshots and report.
# TEST_BROWSER=1
# CHROME_BIN=/usr/bin/chromium
# TEST_BROWSER_OUT=./test-results/browser-agent

# Optional: host port for the local database container (default 5432).
# POSTGRES_PORT=5432
