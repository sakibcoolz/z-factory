# Copy to .env for local development. Never commit real credentials.
# Contract: docs/bootstrap.md -> Environment variable contract.

# PostgreSQL connection string (development defaults match compose.yaml).
DATABASE_URL="postgresql://zfactory:zfactory@localhost:5432/zfactory"

# Optional: database the integration tests may reset. Integration tests are skipped when unset.
TEST_DATABASE_URL="postgresql://zfactory:zfactory@localhost:5432/zfactory_test"

# Single-owner mode (ADR-0007): the owner every factory belongs to. Optional in
# development (defaults to "local-owner"); REQUIRED in production, where the app
# refuses all factory operations without it.
# LOCAL_OWNER_ID=local-owner

# Optional: host port for the local database container (default 5432).
# POSTGRES_PORT=5432
