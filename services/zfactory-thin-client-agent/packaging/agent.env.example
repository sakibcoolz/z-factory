# /etc/zfactory-agent/agent.env (mode 0640, root:zfactory-agent). Read by the systemd
# unit; every setting is documented in docs/thin-client-agent.md. No secret goes here:
# the MQTT password is in its own file, referenced below.

# Local health endpoint (/healthz, /v1/status, /metrics). Keep it on loopback unless a
# monitoring agent on the LAN must scrape it.
ZFACTORY_AGENT_HEALTH_ADDR=127.0.0.1:9180

# The cloud: from Web Factory's agent page (Issue credentials). TLS in production.
ZFACTORY_AGENT_MQTT_URL=mqtts://broker.example.com:8883
ZFACTORY_AGENT_SITE_ID=plant-1
ZFACTORY_AGENT_ID=edge-1
ZFACTORY_AGENT_MQTT_CLIENT_ID=zfactory-agent-plant-1-edge-1
ZFACTORY_AGENT_MQTT_USERNAME=agent:plant-1:edge-1
ZFACTORY_AGENT_MQTT_PASSWORD_FILE=/etc/zfactory-agent/mqtt-password
ZFACTORY_AGENT_MQTT_CA_FILE=/etc/zfactory-agent/broker-ca.crt

# Limits (defaults shown).
# ZFACTORY_AGENT_MAX_CONCURRENT_POLLS=64
# ZFACTORY_AGENT_QUEUE=10000
# ZFACTORY_AGENT_SPOOL_MAX_BYTES=268435456
# ZFACTORY_AGENT_SPOOL_MAX_AGE=168h
# ZFACTORY_AGENT_REPLAY_RATE=50
# ZFACTORY_AGENT_HEARTBEAT=10s
