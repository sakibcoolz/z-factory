// Web Factory's own database (TASK-901, docs/web-factory.md). Nothing here is shared with
// Z-Factory's database: identities that come from the edge (factory, PLC, mapping, module)
// are stored by their external id, as the agent's deployment files and MQTT topics name them.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  VIEWER
  OPERATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

/// What an agent last said about itself on agent/status (the will says OFFLINE). What the
/// pages show is projected from this, the last-seen time and the heartbeat
/// (lib/domain/connectivity.ts), which adds DEGRADED and staleness.
enum AgentStatus {
  /// Registered; nothing heard from it yet.
  UNKNOWN
  ONLINE
  OFFLINE
}

enum MappingAccess {
  READ
  WRITE
}

/// A tenant: everything below belongs to exactly one organization.
model Organization {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  memberships Membership[]
  sites       Site[]
  factories   Factory[]
  auditEvents AuditEvent[]
}

/// A person who signs in. The password hash is scrypt (lib/auth/password.ts).
model User {
  id             String     @id @default(uuid(7)) @db.Uuid
  /// Stored lower-cased.
  email          String     @unique
  name           String
  passwordHash   String
  status         UserStatus @default(ACTIVE)
  /// Raised when the user is disabled, their password or a role changes: older sessions end.
  sessionVersion Int        @default(0)
  failedLogins   Int        @default(0)
  lockedUntil    DateTime?
  lastLoginAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  memberships Membership[]
  auditEvents AuditEvent[]
}

/// A user's role in one organization.
model Membership {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @db.Uuid
  userId         String   @db.Uuid
  role           Role
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

/// A plant location. `siteKey` is the site id in the agents' MQTT topics (zfactory/{siteKey}/…),
/// so it is unique across the whole broker, not only within the organization.
model Site {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @db.Uuid
  siteKey        String   @unique
  name           String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agents       EdgeAgent[]
  factories    Factory[]

  @@index([organizationId])
}

/// A Z-Factory Thin Client Agent at a site. `agentKey` is its agent id in the topics.
model EdgeAgent {
  id                  String      @id @default(uuid(7)) @db.Uuid
  siteId              String      @db.Uuid
  agentKey            String
  name                String
  status              AgentStatus @default(UNKNOWN)
  /// The agent's own time on the status message that set `status`; older ones are ignored.
  statusAt            DateTime?
  /// Web Factory's time of the last live (not retained) message from the agent.
  lastSeenAt          DateTime?
  lastHeartbeatAt     DateTime?
  /// The last heartbeat as sent: counters only, never a secret.
  heartbeatJson       Json?
  agentVersion        String?
  /// The agent's broker client (Mosquitto Dynamic Security). The password is never stored.
  brokerUsername      String?     @unique
  brokerClientId      String?     @unique
  credentialIssuedAt  DateTime?
  credentialRevokedAt DateTime?
  createdAt           DateTime    @default(now())

  site   Site                   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  plcs   Plc[]
  events AgentConnectionEvent[]

  @@unique([siteId, agentKey])
}

/// A change of an agent's reported status, recorded once when Web Factory sees the change.
/// The same report delivered again (a retained message after a reconnect, a QoS 1
/// redelivery) changes nothing and adds no row.
model AgentConnectionEvent {
  id          String      @id @default(uuid(7)) @db.Uuid
  edgeAgentId String      @db.Uuid
  status      AgentStatus
  /// Web Factory's time of the change (the will carries the agent's start time, not its end).
  at          DateTime
  receivedAt  DateTime    @default(now())

  agent EdgeAgent @relation(fields: [edgeAgentId], references: [id], onDelete: Cascade)

  @@unique([edgeAgentId, status, at])
  @@index([edgeAgentId, at])
}

/// A Z-Factory factory, as the agents' deployments name it (`site.factoryId`).
model Factory {
  id                String   @id @default(uuid(7)) @db.Uuid
  organizationId    String   @db.Uuid
  siteId            String   @db.Uuid
  externalFactoryId String
  name              String
  slug              String
  createdAt         DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site         Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  plcs         Plc[]
  modules      Module[]

  @@unique([siteId, externalFactoryId])
  @@index([organizationId])
}

/// A PLC an agent runs, registered from its edge deployment file. `externalPlcId` is the
/// plcId in the topics. The registered deployment is the cloud's copy of the allow-list.
model Plc {
  id                String    @id @default(uuid(7)) @db.Uuid
  edgeAgentId       String    @db.Uuid
  factoryId         String    @db.Uuid
  externalPlcId     String
  name              String
  role              String?
  configVersion     Int
  checksum          String
  /// The deployment as registered: connection settings and mappings, never a secret.
  deploymentJson    Json
  /// The PLC worker's state as the agent last reported it on state/{plcId} (ONLINE,
  /// DEGRADED, RECONNECTING, …; REMOVED when the agent cleared it). Null: never reported.
  edgeState         String?
  /// The agent's time on that state message; older ones are ignored.
  edgeStateAt       DateTime?
  edgeConfigVersion Int?
  edgeLastPollAt    DateTime?
  edgeLastError     String?
  edgeReconnects    Int?
  registeredAt      DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  agent    EdgeAgent    @relation(fields: [edgeAgentId], references: [id], onDelete: Cascade)
  factory  Factory      @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  mappings PlcMapping[]
  modules  PlcModule[]
  latest   TagLatest[]
  events   PlcEvent[]

  @@unique([edgeAgentId, externalPlcId])
  @@index([factoryId])
}

/// One tag of a registered PLC, by its id in telemetry and commands.
model PlcMapping {
  id         String        @id @default(uuid(7)) @db.Uuid
  plcId      String        @db.Uuid
  externalId String
  name       String
  access     MappingAccess
  role       String
  dataType   String
  unit       String?
  min        Float?
  max        Float?

  plc Plc @relation(fields: [plcId], references: [id], onDelete: Cascade)

  @@unique([plcId, externalId])
  @@unique([plcId, name])
}

/// A process module of a factory, as the deployments name it.
model Module {
  id               String   @id @default(uuid(7)) @db.Uuid
  factoryId        String   @db.Uuid
  externalModuleId String
  name             String
  type             String
  createdAt        DateTime @default(now())

  factory Factory     @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  plcs    PlcModule[]

  @@unique([factoryId, externalModuleId])
}

/// A module whose signals a PLC carries.
model PlcModule {
  plcId    String @db.Uuid
  moduleId String @db.Uuid

  plc    Plc    @relation(fields: [plcId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@id([plcId, moduleId])
}

/// The newest value of each tag of a PLC (TASK-903): the latest-state view. Keyed by the
/// tag's external id, which survives a new registration (the PlcMapping rows do not).
/// The history itself is in the `telemetry` schema, outside Prisma (ADR-0020).
model TagLatest {
  plcId         String   @db.Uuid
  /// PlcMapping.externalId.
  tag           String
  valueNum      Float?
  valueBool     Boolean?
  /// As the agent sent it: GOOD or BAD (STALE and DISCONNECTED are projected on read).
  quality       String
  /// The poll time; a value only replaces an older one.
  at            DateTime
  receivedAt    DateTime
  configVersion Int

  plc Plc @relation(fields: [plcId], references: [id], onDelete: Cascade)

  @@id([plcId, tag])
}

enum PlcEventKind {
  /// The PLC worker's state as the agent reported it changed (subject "").
  PLC_STATE
  /// A tag's quality changed (subject: the tag's external id).
  TAG_QUALITY
}

/// What happened to a PLC or one of its tags. The same report delivered again is the
/// same row: unique by PLC, kind, subject and the agent's time.
model PlcEvent {
  id         String       @id @default(uuid(7)) @db.Uuid
  plcId      String       @db.Uuid
  kind       PlcEventKind
  subject    String
  fromValue  String?
  toValue    String
  /// The agent's time (poll time for a tag, state time for the PLC).
  at         DateTime
  receivedAt DateTime     @default(now())

  plc Plc @relation(fields: [plcId], references: [id], onDelete: Cascade)

  @@unique([plcId, kind, subject, at])
  @@index([plcId, at])
}

/// Who did what, for the record: sign-ins, user and role changes, registrations.
model AuditEvent {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String?  @db.Uuid
  actorUserId    String?  @db.Uuid
  action         String
  subjectType    String
  subjectId      String?
  detailJson     Json     @default("{}")
  at             DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, at])
}
