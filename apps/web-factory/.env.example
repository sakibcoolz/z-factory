# Web Factory (apps/web-factory). Copy to .env and fill in; never commit .env.

# Its own database (not Z-Factory's).
WEB_FACTORY_DATABASE_URL="postgresql://zfactory:zfactory@localhost:5432/web_factory"
# Integration tests; reset by the tests.
WEB_FACTORY_TEST_DATABASE_URL="postgresql://zfactory:zfactory@localhost:5432/web_factory_test"

# Signs session cookies: at least 32 random characters (openssl rand -base64 48).
AUTH_SECRET=
# The public URL of this app behind a proxy, e.g. https://factory.example.com
# AUTH_URL=
# Trust the Host header (set when a trusted reverse proxy sets it).
# AUTH_TRUST_HOST=true

# MQTT, server side only (TASK-902, ADR-0019). The password is read from a file. The
# account administers Mosquitto Dynamic Security (the "admin" client MOSQUITTO_DYNSEC_PASSWORD
# creates); use mqtts:// outside development, as agent passwords travel in its commands.
# WEB_FACTORY_MQTT_URL=mqtts://broker.example.com:8883
# WEB_FACTORY_MQTT_USERNAME=admin
# WEB_FACTORY_MQTT_PASSWORD_FILE=/run/secrets/web-factory-mqtt
# WEB_FACTORY_MQTT_CA_FILE=
# WEB_FACTORY_MQTT_CLIENT_ID=
# The broker as agents reach it, shown when their credentials are issued.
# WEB_FACTORY_MQTT_AGENT_URL=mqtts://broker.example.com:8883
# The agents' heartbeat interval in seconds (ZFACTORY_AGENT_HEARTBEAT); 10 by default.
# WEB_FACTORY_AGENT_HEARTBEAT_S=10
